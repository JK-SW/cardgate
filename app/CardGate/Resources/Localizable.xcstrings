            "value": "PIN ke kartě"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN ku karte"
          }
        }
      }
    },
    "Card module cannot be used": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul karty nelze použít"
          }
        },
