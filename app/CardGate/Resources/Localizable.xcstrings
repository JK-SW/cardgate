    },
    "Card module needs approval": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul karty čeká na potvrzení"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul karty čaká na potvrdenie"
          }
        }
      }
    },
    "Card module not found": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul karty nenalezen"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul karty sa nenašiel"
          }
        }
      }
    },
    "Card ready": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
