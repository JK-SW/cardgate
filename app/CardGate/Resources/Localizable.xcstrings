    "The path of the smart card software contains a comma or a line break. Move the module to another folder or contact your IT department.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cesta k softwaru pro čipovou kartu obsahuje čárku nebo zalomení řádku. Přesuňte modul do jiné složky nebo se obraťte na IT oddělení."
          }
        },
