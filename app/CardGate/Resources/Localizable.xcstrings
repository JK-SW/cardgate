{
  "sourceLanguage": "en",
  "strings": {
    "%@ – valid until %@": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – platný do %2$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – platný do %2$@"
          }
        }
      }
    },
    "A wrong PIN was entered before. Only a few attempts remain.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už byl zadán chybný PIN. Zbývá jen několik pokusů."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Už bol zadaný chybný PIN. Zostáva len niekoľko pokusov."
          }
        }
      }
    },
    "About CardGate": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplikaci CardGate"
          }
        },
        "sk": {
