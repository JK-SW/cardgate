          }
        }
      }
    },
    "You have been using CardGate for a while. If it helps you, you can support the author.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CardGate už nějakou dobu používáte. Pokud vám pomáhá, můžete podpořit autora."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "CardGate už nejaký čas používate. Ak vám pomáha, môžete podporiť autora."
          }
        }
      }
    },
    "Your IT department gives you the addresses of the computer and the gateway.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresu počítače a brány vám dá IT oddělení."
          }
        },
