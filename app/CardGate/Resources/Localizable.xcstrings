            "state": "translated",
            "value": "O aplikácii CardGate"
          }
        }
      }
    },
    "Add a connection or show the log": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidat připojení nebo zobrazit záznam"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridať pripojenie alebo zobraziť záznam"
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
