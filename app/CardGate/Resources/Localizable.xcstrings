        }
      }
    },
    "The PIN was not accepted. Be careful: after several wrong attempts the card gets locked.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN nebyl přijat. Pozor: po několika chybných pokusech se karta zablokuje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN nebol prijatý. Pozor: po niekoľkých chybných pokusoch sa karta zablokuje."
          }
        }
      }
    },
    "The application is incomplete. Download and install it again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace je neúplná. Stáhněte ji a nainstalujte znovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácia je neúplná. Stiahnite ju a nainštalujte znova."
          }
        }
      }
    },
    "The card is locked": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta je zablokovaná"
          }
        },
        "sk": {
