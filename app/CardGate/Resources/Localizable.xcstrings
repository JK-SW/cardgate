    "Connect only to addresses you got from your IT department. While connected, the remote computer can use your smart card.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojujte se jen k adresám, které máte od svého IT oddělení. Vzdálený počítač může po dobu připojení používat vaši čipovou kartu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripájajte sa len k adresám, ktoré máte od svojho IT oddelenia. Vzdialený počítač môže počas pripojenia používať vašu čipovú kartu."
          }
        }
      }
    },
    "Connect to your work computer with your smart card.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte se ke svému pracovnímu počítači pomocí čipové karty."
