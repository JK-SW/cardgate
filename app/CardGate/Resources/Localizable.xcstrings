        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácia je neúplná. Stiahnite ju a nainštalujte znova."
          }
        }
      }
    },
    "The card has several sign-in certificates": {
      "localizations": {
