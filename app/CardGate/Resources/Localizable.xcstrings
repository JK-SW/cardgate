    "Automatic (newest valid)": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky (nejnovější platný)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky (najnovší platný)"
          }
        }
      }
    },
    "Automatic uses the strongest security the computer accepts and remembers it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky použije nejsilnější zabezpečení, které počítač přijme, a zapamatuje si ho."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky použije najsilnejšie zabezpečenie, ktoré počítač prijme, a zapamätá si ho."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušit"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušiť"
          }
        }
      }
    },
    "Cancelling…": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruším…"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruším…"
          }
        }
      }
    },
    "Capture keyboard and mouse (system shortcuts go to Windows)": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachytit klávesnici a myš (systémové zkratky jdou do Windows)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachytiť klávesnicu a myš (systémové skratky idú do Windows)"
          }
        }
      }
    },
    "Card": {
      "localizations": {
        "cs": {
          "stringUnit": {
