    "The PIN has %lld–%lld characters. Several wrong attempts lock the card.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN má %lld–%lld znaků. Několik chybných pokusů kartu zablokuje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN má %lld–%lld znakov. Niekoľko chybných pokusov kartu zablokuje."
          }
        }
      }
    },
    "The PIN may have been wrong, or the card or reader failed. Remove the card, insert it again and connect once more. Be careful: after several wrong PINs the card gets locked.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN mohl být chybný, nebo selhala karta či čtečka. Vytáhněte kartu, znovu ji vložte a připojte se znovu. Pozor: po několika chybných PINech se karta zablokuje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN mohol byť chybný, alebo zlyhala karta či čítačka. Vytiahnite kartu, znova ju vložte a pripojte sa znova. Pozor: po niekoľkých chybných PINoch sa karta zablokuje."
          }
        }
      }
    },
    "The PIN was not accepted. Be careful: after several wrong attempts the card gets locked.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN nebyl přijat. Pozor: po několika chybných pokusech se karta zablokuje."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN nebol prijatý. Pozor: po niekoľkých chybných pokusoch sa karta zablokuje."
          }
        }
      }
    },
    "The PIN was not entered in time": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN nebyl zadán včas"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN nebol zadaný včas"
          }
        }
      }
    },
    "The application is incomplete. Download and install it again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace je neúplná. Stáhněte ji a nainstalujte znovu."
