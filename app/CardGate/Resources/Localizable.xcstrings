    "CardGate": {
      "shouldTranslate": false
    },
    "CardGate User Guide": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Návod k CardGate"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Návod na CardGate"
          }
        }
      }
    },
    "CardGate cannot save the settings for the connection. Check the free disk space.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CardGate nemůže uložit nastavení připojení. Zkontrolujte volné místo na disku."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "CardGate nemôže uložiť nastavenie pripojenia. Skontrolujte voľné miesto na disku."
          }
        }
      }
    },
    "CardGate connects only through an RD Gateway, which protects the connection and your PIN.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CardGate se připojuje jen přes bránu (RD Gateway), která chrání spojení i váš PIN."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "CardGate sa pripája len cez bránu (RD Gateway), ktorá chráni spojenie aj váš PIN."
          }
        }
      }
    },
    "CardGate connects only through an RD Gateway, which protects the connection and your PIN. Add the gateway address in the connection settings.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "CardGate se připojuje jen přes bránu (RD Gateway), která chrání spojení i váš PIN. Doplňte adresu brány v nastavení připojení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "CardGate sa pripája len cez bránu (RD Gateway), ktorá chráni spojenie aj váš PIN. Doplňte adresu brány v nastavení pripojenia."
          }
        }
      }
    },
    "Certificate not on the inserted card": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifikát není na vložené kartě"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifikát nie je na vloženej karte"
          }
        }
      }
    },
    "Certificate valid until %@": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifikát platný do %@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifikát platný do %@"
          }
        }
      }
    },
    "Changes you make now will not be saved. Update CardGate to keep your connections up to date.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny, které teď uděláte, se neuloží. Aktualizujte CardGate, aby se vaše připojení dala upravovat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmeny, ktoré teraz urobíte, sa neuložia. Aktualizujte CardGate, aby sa vaše pripojenia dali upravovať."
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolovat aktualizace…"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolovať aktualizácie…"
          }
        }
      }
    },
    "Check for updates automatically": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky vyhledávat aktualizace"
          }
        },
        "sk": {
