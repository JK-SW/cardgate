    },
    "Check the imported connection": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte importované připojení"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte importované pripojenie"
          }
        }
      }
    },
    "Check your internet connection and connect again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte připojení k internetu a připojte se znovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte pripojenie k internetu a pripojte sa znova."
          }
        }
      }
    },
    "Check your internet connection and the gateway address in the connection settings.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte připojení k internetu a adresu brány v nastavení připojení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte pripojenie k internetu a adresu brány v nastaveniach pripojenia."
          }
        }
      }
    },
    "Checking the card…": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověřuji kartu…"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Overujem kartu…"
          }
        }
      }
    },
    "Choose a certificate only if your card holds several valid sign-in certificates.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifikát vybírejte jen tehdy, když má karta několik platných přihlašovacích certifikátů."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifikát vyberajte len vtedy, keď má karta niekoľko platných prihlasovacích certifikátov."
          }
        }
      }
    },
    "Choose the certificate to sign in with: Edit Connection, section Card. If you do not know which one, contact your IT department.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte certifikát pro přihlášení: Upravit připojení, část Karta. Pokud nevíte který, obraťte se na IT oddělení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte certifikát na prihlásenie: Upraviť pripojenie, časť Karta. Ak neviete ktorý, obráťte sa na IT oddelenie."
          }
        }
      }
    },
