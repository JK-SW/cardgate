{
  "sourceLanguage": "en",
  "strings": {
    "%@ – valid until %@": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – platný do %2$@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – platný do %2$@"
          }
        }
      }
    },
    "A renewed certificate is on the card: choose it in the connection settings (section Advanced).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na kartě je obnovený certifikát: vyberte ho v nastavení připojení (část Pokročilé)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na karte je obnovený certifikát: vyberte ho v nastaveniach pripojenia (časť Pokročilé)."
          }
        }
      }
    },
    "A wrong PIN was entered before. Only a few attempts remain.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už byl zadán chybný PIN. Zbývá jen několik pokusů."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Už bol zadaný chybný PIN. Zostáva len niekoľko pokusov."
          }
        }
      }
    },
    "About CardGate": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplikaci CardGate"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplikácii CardGate"
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokročilé"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokročilé"
          }
        }
      }
    },
    "After a short network outage CardGate tries to connect again without you having to enter the PIN.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po krátkém výpadku sítě se CardGate pokusí připojit znovu bez nutnosti zadávat PIN."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po krátkom výpadku siete sa CardGate pokúsi pripojiť znova bez nutnosti zadávať PIN."
          }
        }
      }
    },
    "All other key combinations are sent to Windows.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny ostatní kombinace kláves se posílají do Windows."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky ostatné kombinácie kláves sa posielajú do Windows."
          }
        }
      }
    },
    "Allow or prevent resizing the window": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolit nebo zakázat změnu velikosti okna"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoliť alebo zakázať zmenu veľkosti okna"
          }
        }
      }
    },
    "An administrator or the computer itself disconnected you (for example before a restart). Try again later or contact your IT department.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpojil vás správce nebo sám počítač (např. před restartem). Zkuste to později nebo kontaktujte IT oddělení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpojil vás správca alebo samotný počítač (napr. pred reštartom). Skúste to neskôr alebo kontaktujte IT oddelenie."
          }
        }
      }
    },
    "Another connection took over the session": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Relaci převzalo jiné připojení"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Reláciu prevzalo iné pripojenie"
          }
        }
      }
    },
    "Ask before disconnecting": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ptát se před odpojením"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pýtať sa pred odpojením"
          }
        }
      }
    },
    "Ask your IT department to renew it in time.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádejte IT oddělení o včasnou obnovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Požiadajte IT oddelenie o včasnú obnovu."
          }
        }
      }
    },
