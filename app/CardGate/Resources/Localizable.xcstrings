        }
      }
    },
    "The file with your connections is damaged. You can set up the connection again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor s vašimi připojeními je poškozený. Připojení můžete nastavit znovu."
          }
        },
