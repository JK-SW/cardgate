            "value": "Karta je zablokovaná"
          }
        }
      }
    },
    "The computer cannot be reached": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítač není dostupný"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítač nie je dostupný"
          }
        }
      }
    },
    "The computer may be turned off or the address is wrong. Contact your IT department if it persists.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítač je možná vypnutý nebo je adresa chybná. Pokud potíže trvají, kontaktujte IT oddělení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítač je možno vypnutý alebo je adresa chybná. Ak problémy pretrvávajú, kontaktujte IT oddelenie."
          }
        }
      }
    },
    "The connection failed": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojení se nezdařilo"
