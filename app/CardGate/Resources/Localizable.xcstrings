    "All other key combinations are sent to Windows.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny ostatní kombinace kláves se posílají do Windows."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky ostatné kombinácie kláves sa posielajú do Windows."
          }
        }
      }
    },
    "Allow or prevent resizing the window": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolit nebo zakázat změnu velikosti okna"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoliť alebo zakázať zmenu veľkosti okna"
          }
        }
      }
    },
    "An administrator or the computer itself disconnected you (for example before a restart). Try again later or contact your IT department.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpojil vás správce nebo sám počítač (např. před restartem). Zkuste to později nebo kontaktujte IT oddělení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpojil vás správca alebo samotný počítač (napr. pred reštartom). Skúste to neskôr alebo kontaktujte IT oddelenie."
          }
        }
      }
    },
    "Another connection took over the session": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Relaci převzalo jiné připojení"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Reláciu prevzalo iné pripojenie"
          }
        }
      }
    },
    "Ask your IT department to renew it in time.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádejte IT oddělení o včasnou obnovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Požiadajte IT oddelenie o včasnú obnovu."
          }
        }
      }
    },
