+/**
+ * FreeRDP: A Remote Desktop Protocol Implementation
+ * SDL Client: controls in the title bar of the session window (macOS)
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#import <AppKit/AppKit.h>
+
+#include <tuple>
+
+#include <unistd.h>
+
+#include "sdl_titlebar.hpp"
+
+static const auto &kScales = sdl::titlebar::desktopScales;
+
+enum
+{
+	kSmaller = 0,
+	kScale = 1,
+	kLarger = 2
+};
+
+/* Main thread only. */
+static UINT32 currentScale = 0;
+static bool scaleAdjustable = false;
+/* The scale sdlDispContext::changeScale(0) returns to. */
+static UINT32 connectionScale = 0;
+static NSHashTable *accessories = nil;
+
+static NSString *textOf(const char *name)
+{
+	const char *value = sdl::titlebar::text(name);
+	return value ? [NSString stringWithUTF8String:value] : nil;
+}
+
+/* "150 %" or "150%", as the user's region writes it. */
+static NSString *percentText(UINT32 percent)
+{
+	static NSNumberFormatter *formatter = nil;
+	if (!formatter)
+	{
+		formatter = [NSNumberFormatter new];
+		formatter.numberStyle = NSNumberFormatterPercentStyle;
+		formatter.locale = NSLocale.autoupdatingCurrentLocale;
+		formatter.maximumFractionDigits = 0;
+	}
+	return [formatter stringFromNumber:@(percent / 100.0)];
+}
+
+@interface SdlTitlebarAccessory : NSTitlebarAccessoryViewController
+@property(nonatomic, strong) NSSegmentedControl *scale;
+@property(nonatomic, strong) NSSegmentedControl *log;
+- (void)update;
+@end
+
+@implementation SdlTitlebarAccessory
+
+- (instancetype)initWithScaleHelp:(NSString *)scaleHelp logHelp:(NSString *)logHelp
+{
+	self = [super init];
+	if (!self)
+		return nil;
+
+	NSMutableArray<NSControl *> *controls = [NSMutableArray new];
+
+	if (scaleHelp)
+	{
+		NSString *smaller = textOf("FREERDP_TITLEBAR_SMALLER") ?: @"-";
+		NSString *larger = textOf("FREERDP_TITLEBAR_LARGER") ?: @"+";
+		NSSegmentedControl *scale = [NSSegmentedControl new];
+		scale.segmentCount = 3;
+		scale.trackingMode = NSSegmentSwitchTrackingMomentary;
+		scale.controlSize = NSControlSizeSmall;
+		scale.font = [NSFont monospacedDigitSystemFontOfSize:NSFont.smallSystemFontSize
+		                                              weight:NSFontWeightRegular];
+		[scale setImage:[NSImage imageWithSystemSymbolName:@"minus.magnifyingglass"
+		                          accessibilityDescription:smaller]
+		     forSegment:kSmaller];
+		[scale setImage:[NSImage imageWithSystemSymbolName:@"plus.magnifyingglass"
+		                          accessibilityDescription:larger]
+		     forSegment:kLarger];
+		[scale setToolTip:smaller forSegment:kSmaller];
+		[scale setToolTip:scaleHelp forSegment:kScale];
+		[scale setToolTip:larger forSegment:kLarger];
+		/* Wide enough for "500 %": the control keeps its size when the scale changes. */
+		[scale setWidth:50 forSegment:kScale];
+		[scale setShowsMenuIndicator:YES forSegment:kScale];
+		scale.target = self;
+		scale.action = @selector(scaleClicked:);
+		/* Keys keep going to the session. */
+		scale.refusesFirstResponder = YES;
+		scale.accessibilityLabel = scaleHelp;
+		self.scale = scale;
+		[controls addObject:scale];
+	}
+
+	if (logHelp)
+	{
+		NSImage *image = [NSImage imageWithSystemSymbolName:@"list.bullet.rectangle"
+		                           accessibilityDescription:logHelp];
+		NSSegmentedControl *log =
+		    [NSSegmentedControl segmentedControlWithImages:@[image]
+		                                      trackingMode:NSSegmentSwitchTrackingMomentary
+		                                            target:self
+		                                            action:@selector(logClicked:)];
+		log.controlSize = NSControlSizeSmall;
+		[log setToolTip:logHelp forSegment:0];
+		log.refusesFirstResponder = YES;
+		self.log = log;
+		[controls addObject:log];
+	}
+
+	/* A title bar accessory keeps the width of its view's frame (Auto Layout does not size it):
+	 * lay the controls out side by side, centred in the height of the title bar. */
+	const CGFloat gap = 8;
+	const CGFloat margin = 8;
+	CGFloat height = 0;
+	for (NSControl *control in controls)
+	{
+		[control sizeToFit];
+		height = MAX(height, NSHeight(control.frame));
+	}
+	NSView *container = [[NSView alloc] initWithFrame:NSZeroRect];
+	CGFloat x = 0;
+	for (NSControl *control in controls)
+	{
+		NSRect frame = control.frame;
+		frame.origin = NSMakePoint(x, floor((height - NSHeight(frame)) / 2));
+		control.frame = frame;
+		control.autoresizingMask = NSViewMinYMargin | NSViewMaxYMargin;
+		[container addSubview:control];
+		x += NSWidth(frame) + gap;
+	}
+	container.frame = NSMakeRect(0, 0, (x > 0) ? x - gap + margin : 0, height);
+	self.view = container;
+	self.layoutAttribute = NSLayoutAttributeTrailing;
+	[self update];
+	return self;
+}
+
+- (void)update
+{
+	if (!self.scale)
+		return;
+	[self.scale setLabel:(currentScale > 0) ? percentText(currentScale) : @"–" forSegment:kScale];
+	[self.scale setEnabled:scaleAdjustable && (currentScale > kScales.front()) forSegment:kSmaller];
+	[self.scale setEnabled:scaleAdjustable forSegment:kScale];
+	[self.scale setEnabled:scaleAdjustable && (currentScale < kScales.back()) forSegment:kLarger];
+}
+
+- (void)scaleClicked:(NSSegmentedControl *)sender
+{
+	switch (sender.selectedSegment)
+	{
+		case kSmaller:
+			std::ignore = sdl::titlebar::requestScale(-1);
+			break;
+		case kLarger:
+			std::ignore = sdl::titlebar::requestScale(1);
+			break;
+		case kScale:
+			[self showScaleMenu];
+			break;
+		default:
+			break;
+	}
+}
+
+/* The list of scales, below the percentage like the menu of a pop-up button. */
+- (void)showScaleMenu
+{
+	NSMenu *menu = [NSMenu new];
+	menu.autoenablesItems = NO;
+	for (const UINT32 scale : kScales)
+	{
+		NSMenuItem *item = [[NSMenuItem alloc] initWithTitle:percentText(scale)
+		                                              action:@selector(scaleChosen:)
+		                                       keyEquivalent:@""];
+		item.target = self;
+		item.tag = scale;
+		item.state = (scale == currentScale) ? NSControlStateValueOn : NSControlStateValueOff;
+		[menu addItem:item];
+	}
+	NSString *name = textOf("FREERDP_TITLEBAR_DEFAULT_SCALE");
+	if (name && (connectionScale > 0))
+	{
+		[menu addItem:NSMenuItem.separatorItem];
+		NSString *title =
+		    [NSString stringWithFormat:@"%@ (%@)", name, percentText(connectionScale)];
+		NSMenuItem *item = [[NSMenuItem alloc] initWithTitle:title
+		                                              action:@selector(scaleChosen:)
+		                                       keyEquivalent:@""];
+		item.target = self;
+		item.tag = 0;
+		[menu addItem:item];
+	}
+
+	NSSegmentedControl *control = self.scale;
+	CGFloat left = 0;
+	for (NSInteger segment = 0; segment < kScale; segment++)
+		left += [control widthForSegment:segment];
+	if (left == 0) /* automatic widths: the percentage sits in the middle third */
+		left = (NSWidth(control.bounds) - [control widthForSegment:kScale]) / 2;
+	const CGFloat below = control.isFlipped ? NSMaxY(control.bounds) + 4 : -4;
+	[menu popUpMenuPositioningItem:nil atLocation:NSMakePoint(left, below) inView:control];
+}
+
+- (void)scaleChosen:(NSMenuItem *)item
+{
+	std::ignore = sdl::titlebar::requestScale(static_cast<int>(item.tag));
+}
+
+- (void)logClicked:(NSSegmentedControl *)sender
+{
+	/* The app showing the log is not active: only the active app can let it come forward
+	 * (it started the client, so it is the parent process). */
+	NSRunningApplication *parent =
+	    [NSRunningApplication runningApplicationWithProcessIdentifier:getppid()];
+	if (parent)
+		[NSApp yieldActivationToApplication:parent];
+	std::ignore = sdl::titlebar::requestLog();
+}
+
+@end
+
+namespace sdl::titlebar
+{
+void attach(SDL_Window *window)
+{
+	NSString *scaleHelp = textOf("FREERDP_TITLEBAR_SCALE");
+	NSString *logHelp = textOf("FREERDP_TITLEBAR_LOG");
+	if (!window || (!scaleHelp && !logHelp))
+		return;
+	NSWindow *nswindow = (__bridge NSWindow *)SDL_GetPointerProperty(
+	    SDL_GetWindowProperties(window), SDL_PROP_WINDOW_COCOA_WINDOW_POINTER, nullptr);
+	/* Borderless windows (every display) have no title bar. */
+	if (!nswindow || ((nswindow.styleMask & NSWindowStyleMaskTitled) == 0))
+		return;
+
+	SdlTitlebarAccessory *accessory = [[SdlTitlebarAccessory alloc] initWithScaleHelp:scaleHelp
+	                                                                          logHelp:logHelp];
+	if (!accessory)
+		return;
+	if (!accessories)
+		accessories = [NSHashTable weakObjectsHashTable];
+	[accessories addObject:accessory];
+	[nswindow addTitlebarAccessoryViewController:accessory];
+}
+
+void showScale(UINT32 percent, UINT32 connectionPercent, bool adjustable)
+{
+	dispatch_async(dispatch_get_main_queue(), ^{
+		currentScale = percent;
+		connectionScale = connectionPercent;
+		scaleAdjustable = adjustable;
+		for (SdlTitlebarAccessory *accessory in accessories)
+			[accessory update];
+	});
+}
+} // namespace sdl::titlebar
