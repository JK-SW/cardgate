+UINT32 sdlDispContext::scale() const
+{
+	/* A change waiting to be sent counts already (the next step starts from it). */
+	if (_scaleChanged)
+	{
+		const UINT32 requested = _requestedScale;
+		if (requested >= 100)
+			return requested;
+	}
+	const UINT32 sent = _scale;
+	return (sent >= 100) ? sent : connectionScale();
+}
+
+UINT32 sdlDispContext::connectionScale() const
+{
+	const UINT32 scale = _connectedScale;
+	if (scale >= 100)
+		return scale;
+	/* Before the channel is up nothing changes the settings yet. */
+	const auto connected =
+	    freerdp_settings_get_uint32(_sdl->context()->settings, FreeRDP_DesktopScaleFactor);
+	return (connected >= 100) ? connected : 100;
+}
+
+void sdlDispContext::showScale() const
+{
+	sdl::titlebar::showScale(scale(), connectionScale(), _adjustable);
+}
+
+bool sdlDispContext::changeScale(int request)
+{
+	auto settings = _sdl->context()->settings;
+	WINPR_ASSERT(settings);
+	if (!_adjustable || !_disp)
+		return true;
+
+	const auto key = FreeRDP_MonitorOverrideFlags;
+	const auto flag = FREERDP_MONITOR_OVERRIDE_DESKTOP_SCALE;
+	const bool overridden = (freerdp_settings_get_uint64(settings, key) & flag) != 0;
+	if (!_scaleChanged)
+		_connectedOverride = overridden;
+
+	const auto current = scale();
+	const auto& scales = sdl::titlebar::desktopScales;
+	bool override = true;
+	UINT32 target = 0;
+	if (request == 0)
+	{
+		override = _connectedOverride;
+		target = connectionScale();
+	}
+	else if (request == 1)
+	{
+		auto next =
+		    std::find_if(scales.begin(), scales.end(), [current](UINT32 s) { return s > current; });
+		if (next == scales.end())
+			return true;
+		target = *next;
+	}
+	else if (request == -1)
+	{
+		auto next = std::find_if(scales.rbegin(), scales.rend(),
+		                         [current](UINT32 s) { return s < current; });
+		if (next == scales.rend())
+			return true;
+		target = *next;
+	}
+	else if (std::find(scales.begin(), scales.end(), static_cast<UINT32>(request)) != scales.end())
+		target = static_cast<UINT32>(request);
+	else
+		return true;
+
+	/* Nothing changes (e.g. the scale in effect chosen from the list). */
+	if ((override == overridden) && (!override || (target == current)))
+		return true;
+
+	/* The scale given on the command line applies to every monitor (sendLayout); without it
+	 * each monitor has the scale of its display again. */
+	auto mask = freerdp_settings_get_uint64(settings, key);
+	mask = override ? (mask | flag) : (mask & ~static_cast<UINT64>(flag));
+	if (!freerdp_settings_set_uint64(settings, key, mask))
+		return false;
+	if ((target >= 100) &&
+	    !freerdp_settings_set_uint32(settings, FreeRDP_DesktopScaleFactor, target))
+		return false;
+	_requestedScale = override ? target : 0;
+	_scaleChanged = true;
+	WLog_Print(_sdl->getWLog(), WLOG_INFO, "desktop scale changed in the title bar: %s",
+	           override ? std::to_string(target).c_str() : "the scale of each display");
+
+	/* As after resizing the window: its monitor gets the window's size (not the display's). */
+	if (!freerdp_settings_get_bool(settings, FreeRDP_UseMultimon))
+	{
+		auto window = _sdl->getFirstWindow();
+		if (window && (!_sdl->updateWindow(window->id()) || !_sdl->updateWindowList()))
+			return false;
+	}
+	showScale();
+	/* Sent within RESIZE_MIN_DELAY of the last layout or of the caps, Windows would ignore it:
+	 * the timer sends it once that has passed. */
+	return addTimer();
+}
