+
+/* Controls in the title bar of the session window: the desktop scale of the remote computer
+ * (smaller, larger, a list) and a button that asks the app which started the client to show its
+ * connection log. They show only when that app gives their texts in its language:
+ *   FREERDP_TITLEBAR_SCALE          the scale control (its help text)
+ *   FREERDP_TITLEBAR_SMALLER        smaller
+ *   FREERDP_TITLEBAR_LARGER         larger
+ *   FREERDP_TITLEBAR_DEFAULT_SCALE  the scale of the connection (in the list)
+ *   FREERDP_TITLEBAR_LOG            the log button; the request is a log line (showLogRequest)
+ * The actions are SDL user events handled by the main loop on every platform (requestScale,
+ * requestLog); only the controls are native (sdl_titlebar_macos.mm, nothing elsewhere yet). */
+namespace sdl::titlebar
+{
+	/* The scales Windows offers in its display settings (percent). */
+	inline constexpr std::array<UINT32, 12> desktopScales = { 100, 125, 150, 175, 200, 225,
+	                                                          250, 300, 350, 400, 450, 500 };
+
+	/* The INFO line the client logs when the user asks for the connection log. */
+	inline constexpr const char* showLogRequest = "the user asked to show the connection log";
+
+	/* A non-empty environment variable, or nullptr. */
+	[[nodiscard]] const char* text(const char* name);
+
+	/* See sdlDispContext::changeScale. */
+	[[nodiscard]] bool requestScale(int request);
+	[[nodiscard]] bool requestLog();
+
+	/* Adds the controls to a window with a title bar (main thread). */
+	void attach(SDL_Window* window);
+	/* Shows the desktop scale and the one of the connection (percent); adjustable: it can be
+	 * changed now. Any thread. */
+	void showScale(UINT32 percent, UINT32 connectionPercent, bool adjustable);
+} // namespace sdl::titlebar
