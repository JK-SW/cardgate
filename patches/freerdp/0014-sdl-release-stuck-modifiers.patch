+ * released. Returns true for such a key (down, repeat or its release). Cmd+Q: sdl_context. */
+bool sdlInput::handleMenuShortcut(const SDL_KeyboardEvent& ev)
+{
+#if defined(__APPLE__)
+	if (ev.type == SDL_EVENT_KEY_UP)
+		return _menuShortcutKeys.erase(ev.scancode) > 0;
+	const SDL_Keymod mods = ev.mod & (SDL_KMOD_GUI | SDL_KMOD_CTRL | SDL_KMOD_ALT | SDL_KMOD_SHIFT);
+	const bool cmd = (mods & SDL_KMOD_GUI) != 0;
+	const bool cmdOnly = cmd && ((mods & ~SDL_KMOD_GUI) == 0);
+	const bool cmdAlt =
+	    cmd && ((mods & SDL_KMOD_ALT) != 0) && ((mods & ~(SDL_KMOD_GUI | SDL_KMOD_ALT)) == 0);
+	const bool cmdCtrl =
+	    cmd && ((mods & SDL_KMOD_CTRL) != 0) && ((mods & ~(SDL_KMOD_GUI | SDL_KMOD_CTRL)) == 0);
+	const bool shortcut =
+	    (cmdOnly && ((ev.key == SDLK_M) || (ev.key == SDLK_H) || (ev.key == SDLK_W))) ||
+	    (cmdAlt && (ev.key == SDLK_H)) || (cmdCtrl && (ev.key == SDLK_F));
+	if (!shortcut)
+		return false;
+	/* A repeat of a key that went to the session before Cmd was pressed still goes there. */
+	if (ev.repeat)
+		return _menuShortcutKeys.count(ev.scancode) > 0;
+	if (!_menuShortcutKeys.insert(ev.scancode).second)
+		return true;
+	WLog_Print(_sdl->getWLog(), WLOG_INFO, "Cmd+%s is a macOS shortcut, not sent to the session",
+	           SDL_GetKeyName(ev.key));
+	/* Also with Ctrl held: it may have been pressed before Cmd. */
+	std::ignore = sdl_tap_mask_key(_sdl->context()->input);
+	return true;
+#else
+	WINPR_UNUSED(ev);
+	return false;
+#endif
+}
