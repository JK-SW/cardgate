+		WLog_Print(sdl->getWLog(), WLOG_INFO, "signed in: releasing the modifier keys not held");
+		std::ignore = sdl_push_user_event(SDL_EVENT_USER_RELEASE_MODIFIERS);
+	}
+	return TRUE;
+}
