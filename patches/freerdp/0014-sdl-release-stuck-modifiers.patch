+static constexpr Uint32 sdl_pending_win_release_ms = 150;
+
+[[nodiscard]] static Uint32 sdl_pending_win_release_timer(void* userdata, SDL_TimerID timerID,
+                                                          Uint32 interval)
+{
+	WINPR_UNUSED(userdata);
+	WINPR_UNUSED(timerID);
+	WINPR_UNUSED(interval);
+	std::ignore = sdl_push_user_event(SDL_EVENT_USER_RELEASE_PENDING_WIN);
+	return 0;
