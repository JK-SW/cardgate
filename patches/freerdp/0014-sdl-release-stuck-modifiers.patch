+/* The modifier keys and their state bits. */
+static const std::array<std::pair<SDL_Scancode, SDL_Keymod>, 8> sdl_modifier_keys = {
+	{ { SDL_SCANCODE_LSHIFT, SDL_KMOD_LSHIFT },
+	  { SDL_SCANCODE_RSHIFT, SDL_KMOD_RSHIFT },
+	  { SDL_SCANCODE_LCTRL, SDL_KMOD_LCTRL },
+	  { SDL_SCANCODE_RCTRL, SDL_KMOD_RCTRL },
+	  { SDL_SCANCODE_LALT, SDL_KMOD_LALT },
+	  { SDL_SCANCODE_RALT, SDL_KMOD_RALT },
+	  { SDL_SCANCODE_LGUI, SDL_KMOD_LGUI },
+	  { SDL_SCANCODE_RGUI, SDL_KMOD_RGUI } }
+};
+
+/* A key counts as held when the modifier state of the event says so or the key state does:
+ * keyboard_set_indicators replaces the modifier state, and the key state is already the one after
+ * every queued event. Main thread only (SDL's keyboard state). */
+[[nodiscard]] static bool sdl_key_held(SDL_Scancode code, SDL_Keymod mod, SDL_Keymod held,
+                                       const bool* keys)
+{
+	return ((held & mod) != 0) || (keys && keys[code]);
+}
+
+[[nodiscard]] static bool sdl_any_modifier_held(SDL_Keymod held, const bool* keys)
+{
+	for (const auto& [code, mod] : sdl_modifier_keys)
+	{
+		if (sdl_key_held(code, mod, held, keys))
+			return true;
+	}
+	return false;
+}
+
+void sdlInput::trackModifier(const SDL_KeyboardEvent& ev, UINT32 scancode)
+{
+	for (const auto& [code, mod] : sdl_modifier_keys)
+	{
+		if (code != ev.scancode)
+			continue;
+		if (ev.type == SDL_EVENT_KEY_DOWN)
+			_sentModifiers[code] = scancode;
+		else
+			_sentModifiers.erase(code);
+	}
+}
+
+/* Releasing the Windows key or Alt alone opens the Start menu or activates the menu bar; a key
+ * between keeps them closed. F15: no app reacts to it (Ctrl made apps show their access keys). */
+[[nodiscard]] static bool sdl_tap_mask_key(rdpInput* input)
+{
+	return freerdp_input_send_keyboard_event_ex(input, TRUE, FALSE, RDP_SCANCODE_F15) &&
+	       freerdp_input_send_keyboard_event_ex(input, FALSE, FALSE, RDP_SCANCODE_F15);
+}
+
+/* Releases with the mask key tap before (tapMask) for the Windows key or Alt. It is left out
+ * while a modifier is held: that key already came in between. */
+bool sdlInput::keyboard_tap_mask_key()
+{
+	return sdl_tap_mask_key(_sdl->context()->input);
+}
+
+bool sdlInput::sendModifierReleases(const std::vector<UINT32>& scancodes, bool tapMask)
+{
+	auto input = _sdl->context()->input;
+	WINPR_ASSERT(input);
+	const bool menuKey =
+	    std::any_of(scancodes.cbegin(), scancodes.cend(),
+		            [](UINT32 scancode)
+		            {
+		                return (scancode == RDP_SCANCODE_LWIN) || (scancode == RDP_SCANCODE_RWIN) ||
+						       (scancode == RDP_SCANCODE_LMENU) || (scancode == RDP_SCANCODE_RMENU);
+	                });
+	if (tapMask && menuKey && !sdl_tap_mask_key(input))
+		return false;
+	for (const auto scancode : scancodes)
+	{
+		if (!freerdp_input_send_keyboard_event_ex(input, FALSE, FALSE, scancode))
+			return false;
+	}
+	return true;
+}
+
+/* A modifier sent as pressed whose release never reached the session stays pressed there: the
+ * Windows key (Cmd) turns a typed L into Win+L, which locks the session. Release the modifiers
+ * that are no longer held before the next key. */
+bool sdlInput::releaseStuckModifiers(SDL_Keymod held)
+{
+	const bool* keys = SDL_GetKeyboardState(nullptr);
+	std::vector<UINT32> stuck;
+	for (const auto& [code, mod] : sdl_modifier_keys)
+	{
+		const auto it = _sentModifiers.find(code);
+		if ((it == _sentModifiers.end()) || sdl_key_held(code, mod, held, keys))
+			continue;
+		WLog_Print(_sdl->getWLog(), WLOG_WARN, "releasing %s, its release did not arrive",
+		           SDL_GetScancodeName(code));
+		stuck.push_back(it->second);
+		_sentModifiers.erase(it);
+	}
+	if (stuck.empty())
+		return true;
+	return sendModifierReleases(stuck, !sdl_any_modifier_held(held, keys));
+}
+
+/* The session keeps the keys that were pressed when it was disconnected (Cmd+Q in an older
+ * version sent Cmd, the Windows key, and disconnected): release the modifiers not held
+ * (SDL_EVENT_USER_RELEASE_MODIFIERS, pushed when connected and signed in). */
+bool sdlInput::keyboard_release_modifiers()
+{
+	const bool* keys = SDL_GetKeyboardState(nullptr);
+	const SDL_Keymod held = SDL_GetModState();
+	std::vector<UINT32> released;
+	for (const auto& [code, mod] : sdl_modifier_keys)
+	{
+		if (sdl_key_held(code, mod, held, keys))
+			continue;
+		_sentModifiers.erase(code);
+		released.push_back(freerdp_keyboard_remap_key(_remapTable, scancode_to_rdp(code)));
+	}
+	_pendingWinRelease = 0; /* released with the others */
+	return sendModifierReleases(released, !sdl_any_modifier_held(held, keys));
+}
+
+/* Releases the modifiers sent as pressed before the user disconnects (Cmd+Q, the disconnect
+ * hotkey): the session would keep them. Without the mask key: it ends the session anyway. */
+bool sdlInput::keyboard_release_sent()
+{
+	std::vector<UINT32> sent;
+	for (const auto& [code, scancode] : _sentModifiers)
+		sent.push_back(scancode);
+	_sentModifiers.clear();
+	if (_pendingWinRelease != 0)
+		sent.push_back(_pendingWinRelease);
+	_pendingWinRelease = 0;
+	WLog_Print(_sdl->getWLog(), WLOG_INFO, "released the modifier keys before disconnecting");
+	return sendModifierReleases(sent, false);
+}
