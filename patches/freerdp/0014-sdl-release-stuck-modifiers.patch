+ * session the user returns to still has the keys that were pressed when it was disconnected; the
+ * release when connecting went to the sign-in screen. Best effort: the info is handled anyway. */
+[[nodiscard]] static BOOL sdl_save_session_info(rdpContext* context, UINT32 type, const void* data)
