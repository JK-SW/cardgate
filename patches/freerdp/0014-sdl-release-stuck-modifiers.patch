+bool sdlInput::holdLoneWinRelease(const SDL_KeyboardEvent& ev, UINT32 scancode)
+{
+	const bool win = (ev.scancode == SDL_SCANCODE_LGUI) || (ev.scancode == SDL_SCANCODE_RGUI);
+	if ((ev.type != SDL_EVENT_KEY_UP) || !win || _keySinceWinDown ||
+	    (_sentModifiers.find(ev.scancode) == _sentModifiers.end()))
+		return false;
+	if (!keyboard_release_pending())
+		return false;
+	if (SDL_AddTimer(sdl_pending_win_release_ms, sdl_pending_win_release_timer, nullptr) == 0)
+		return false; /* sent as it is */
+	trackModifier(ev, scancode);
+	_pendingWinRelease = scancode;
+	_pendingWinReleaseAt = SDL_GetTicks() + sdl_pending_win_release_ms;
+	return true;
+}
+
+bool sdlInput::keyboard_release_pending(bool fromTimer)
+{
+	if ((_pendingWinRelease == 0) || (fromTimer && (SDL_GetTicks() < _pendingWinReleaseAt)))
+		return true;
+	const UINT32 scancode = _pendingWinRelease;
+	_pendingWinRelease = 0;
+	const bool focused = SDL_GetKeyboardFocus() != nullptr;
+	if (!focused)
+		WLog_Print(_sdl->getWLog(), WLOG_INFO,
+		           "releasing the Windows key, the window lost the focus after it");
+	return sendModifierReleases({ scancode }, !focused && _sentModifiers.empty());
+}
