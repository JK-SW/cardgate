+/* The display of a single monitor session: FREERDP_SDL_DISPLAY (macOS: the CoreGraphics display
+ * ID, SdlWindow::isCoreGraphicsDisplay), otherwise or if not connected the first
+ * one (the main display). */
+[[nodiscard]] static SDL_DisplayID sdl_full_screen_display(const std::vector<SDL_DisplayID>& ids)
+{
+	WINPR_ASSERT(!ids.empty());
+#if defined(__APPLE__)
+	const char* value = getenv("FREERDP_SDL_DISPLAY");
+	if (!value || (*value == '\0'))
+		return ids.front();
+	char* end = nullptr;
+	errno = 0;
+	const auto wanted = strtoul(value, &end, 10);
+	if ((errno != 0) || !end || (*end != '\0') || (wanted == 0) || (wanted > UINT32_MAX))
+	{
+		WLog_WARN(TAG, "FREERDP_SDL_DISPLAY is not a display ID, using the main display");
+		return ids.front();
+	}
+	for (const auto id : ids)
+	{
+		if (SdlWindow::isCoreGraphicsDisplay(id, static_cast<uint32_t>(wanted)))
+		{
+			const char* name = SDL_GetDisplayName(id);
+			WLog_INFO(TAG, "full screen on the chosen display %" PRIu32 " (%s)", id,
+			          name ? name : "");
+			return id;
+		}
+	}
+	WLog_WARN(TAG, "the chosen display %lu is not connected, using the main display", wanted);
+#endif
+	return ids.front();
+}
