+/* SDL takes the bounds of a display from CoreGraphics (CGDisplayBounds, cut to int) and does not
+ * tell its CoreGraphics ID: the display is the one with the same bounds. */
+bool SdlWindow::isCoreGraphicsDisplay(SDL_DisplayID id, uint32_t coreGraphicsID)
+{
+#if defined(__APPLE__)
+	SDL_Rect bounds = {};
+	if ((coreGraphicsID == 0) || !SDL_GetDisplayBounds(id, &bounds))
+		return false;
+	const CGRect r = CGDisplayBounds(coreGraphicsID);
+	return (static_cast<int>(r.origin.x) == bounds.x) &&
+	       (static_cast<int>(r.origin.y) == bounds.y) &&
+	       (static_cast<int>(r.size.width) == bounds.w) &&
+	       (static_cast<int>(r.size.height) == bounds.h);
+#else
+	WINPR_UNUSED(id);
+	WINPR_UNUSED(coreGraphicsID);
+	return false;
+#endif
+}
