 	if (suppress && freerdp_settings_get_bool(context()->settings, FreeRDP_RemoteApplicationMode))
 		return true;
 
+	/* While reconnecting there is no session to tell (input is skipped then, too); a session
+	 * restored later sends its output anyway. */
+	if (!freerdp_is_active_state(context()))
+		return true;
+
 	auto gdi = context()->gdi;
 	WINPR_ASSERT(gdi);
-	return gdi_send_suppress_output(gdi, suppress);
+	/* Only spares the server drawing: a session that broke meanwhile is noticed by the RDP thread,
+	 * a window event must not end the client for it. */
+	if (!gdi_send_suppress_output(gdi, suppress))
+		WLog_Print(_log, WLOG_WARN, "Could not send suppress output (%d)", suppress);
+	return true;
 }
 
