+/* Logs the reader names of a multi-string (names only, never card data). */
+static void log_reader_names(wLog* log, const char* what, const char* msz, size_t cch)
+{
+	if (!WLog_IsLevelActive(log, WLOG_DEBUG))
+		return;
+	size_t count = 0;
+	for (size_t pos = 0; msz && pos < cch && msz[pos];)
+	{
+		const size_t len = strnlen(&msz[pos], cch - pos);
+		WLog_Print(log, WLOG_DEBUG, "%s reader %" PRIuz ": '%s'", what, count++, &msz[pos]);
+		pos += len + 1;
+	}
+	WLog_Print(log, WLOG_DEBUG, "%s: %" PRIuz " reader(s)", what, count);
+}
