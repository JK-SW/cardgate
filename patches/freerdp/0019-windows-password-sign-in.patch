@@ -64,6 +64,14 @@
 WINPR_ATTR_NODISCARD
 FREERDP_LOCAL BOOL rdp_send_client_info(rdpRdp* rdp);
 
+/* Sign in to Windows with a password typed in Windows instead of the smart card
+ * (FREERDP_WINDOWS_SIGN_IN=password): Windows gets no PIN and no domain. The Client Info packet
+ * carries the user name without a password and without automatic sign-in (Windows fills it in
+ * without NLA); the NLA credentials are empty (with NLA Windows shows an empty sign-in screen).
+ * The smart card still authenticates to the gateway and NLA. */
+WINPR_ATTR_NODISCARD
+FREERDP_LOCAL BOOL freerdp_windows_password_sign_in(const rdpSettings* settings);
+
 WINPR_ATTR_NODISCARD
 FREERDP_LOCAL BOOL rdp_recv_save_session_info(rdpRdp* rdp, wStream* s);
 
--- a/libfreerdp/core/info.c
+++ b/libfreerdp/core/info.c
@@ -809,6 +809,13 @@
 	return TRUE;
 }
 
+BOOL freerdp_windows_password_sign_in(const rdpSettings* settings)
+{
+	WINPR_ASSERT(settings);
+	const char* method = getenv("FREERDP_WINDOWS_SIGN_IN");
+	return settings->SmartcardLogon && method && (strcmp(method, "password") == 0);
+}
