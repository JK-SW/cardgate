+/**
+ * FreeRDP: A Remote Desktop Protocol Implementation
+ * RD Gateway smart card extended authentication (HTTP_EXTENDED_AUTH_SC)
+ *
+ * The gateway runs a TLS 1.2 handshake with client certificate inside
+ * PKT_TYPE_EXTENDED_AUTH_MSG packets. The private key stays on the card,
+ * signatures are made through a PKCS#11 module.
+ *
+ * Licensed under the Apache License, Version 2.0
+ */
+
+#ifndef FREERDP_LIB_CORE_GATEWAY_RDG_SC_H
+#define FREERDP_LIB_CORE_GATEWAY_RDG_SC_H
+
+#include <winpr/wtypes.h>
+
+typedef struct rdg_sc rdgSc;
+
+/* modulePath: PKCS#11 module, slotId: PKCS#11 slot, certIdHex: CKA_ID of the key/cert (hex),
+ * certDer: client certificate, pin: user PIN (logs in exactly once, never retried). */
+rdgSc* rdg_sc_new(const char* modulePath, UINT32 slotId, const char* certIdHex,
+                  const BYTE* certDer, size_t certLen, const char* pin, const char* sni);
+void rdg_sc_free(rdgSc* sc);
+
+/* TRUE once the card rejected the PIN in this process; no further login may be attempted. */
+BOOL rdg_sc_pin_rejected(void);
+
+/* Feeds the gateway's handshake data (in may be NULL for the first call), advances the inner
+ * TLS handshake. *out (malloc'ed, may be NULL) receives data to send to the gateway,
+ * *done is set once the handshake completed. Returns FALSE on error. */
+BOOL rdg_sc_step(rdgSc* sc, const BYTE* in, size_t inLen, BYTE** out, size_t* outLen, BOOL* done);
+
+/* RDG-User-Id header value for smart card auth, as mstsc sends it:
+ * base64(UTF-16LE("@@B" + CredMarshalCredential(CertCredential, SHA1(cert)))). Caller frees. */
+char* rdg_sc_user_id_from_sha1(const BYTE sha1[20]);
+
+/* The certificate the gateway presented on the outer TLS connection; the inner handshake is
+ * aborted if the server presents a different one. */
+BOOL rdg_sc_set_expected_peer(rdgSc* sc, struct x509_st* certificate);
+
+/* Access to the inner TLS session (after the handshake) and draining its pending output. */
+struct ssl_st* rdg_sc_ssl(rdgSc* sc);
+BOOL rdg_sc_drain(rdgSc* sc, BYTE** out, size_t* outLen);
+
+#endif /* FREERDP_LIB_CORE_GATEWAY_RDG_SC_H */
