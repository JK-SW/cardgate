+WINPR_ATTR_NODISCARD
+static BOOL rdg_sc_continue(rdpRdg* rdg, const BYTE* in, size_t inLen)
+{
+	BYTE* out = nullptr;
+	size_t outLen = 0;
+	BOOL done = FALSE;
+
+	if (!rdg_sc_step(rdg->sc, in, inLen, &out, &outLen, &done))
+		return FALSE;
+
+	BOOL rc = TRUE;
+	if (outLen > 0)
+		rc = rdg_send_extauth_blob(rdg, out, outLen);
+	free(out);
+	if (!rc)
+		return FALSE;
+
+	if (done)
+	{
+		/* mstscax (CAASCAuthClient::GetEncryptedCBToken): after the handshake the client sends,
+		 * encrypted with the inner TLS session, the UTF-16 string
+		 * "<RDG-Connection-Id>:b48ab399-022e-47b7-9492-7765d9699199" incl. the terminating NUL.
+		 * This binds the smart card authentication to this HTTP connection. */
+		const char* connId = http_context_get_header(rdg->http, "RDG-Connection-Id");
+		if (!connId)
+			return FALSE;
+		char token[128] = WINPR_C_ARRAY_INIT;
+		const int tokenLen =
+		    _snprintf(token, sizeof(token), "%s:b48ab399-022e-47b7-9492-7765d9699199", connId);
+		if ((tokenLen < 0) || ((size_t)tokenLen >= sizeof(token)))
+		{
+			WLog_Print(rdg->log, WLOG_ERROR, "RDG-Connection-Id too long");
+			return FALSE;
+		}
+		BYTE wtoken[256] = WINPR_C_ARRAY_INIT;
+		const size_t tlen = strnlen(token, sizeof(token));
+		for (size_t i = 0; i < tlen; i++)
+			wtoken[2 * i] = (BYTE)token[i];
+		const size_t wlen = 2 * tlen + 2;
+
+		if (SSL_write(rdg_sc_ssl(rdg->sc), wtoken, (int)wlen) != (int)wlen)
+			return FALSE;
+		if (!rdg_sc_drain(rdg->sc, &out, &outLen))
+			return FALSE;
+		WLog_Print(rdg->log, WLOG_DEBUG, "sending channel binding token (%" PRIuz " bytes)", outLen);
+		rc = rdg_send_extauth_blob(rdg, out, outLen);
+		free(out);
+		if (!rc)
+			return FALSE;
+		rdg->scCbSent = TRUE;
+	}
+	return TRUE;
+}
