+WINPR_ATTR_NODISCARD
+static BOOL rdg_process_extauth_sc(rdpRdg* rdg, wStream* s)
+{
+	UINT32 errorCode = 0;
+	UINT16 blobLen = 0;
+
+	if (!Stream_CheckAndLogRequiredLengthWLog(rdg->log, s, 6))
+		return FALSE;
+	Stream_Read_UINT32(s, errorCode);
+	Stream_Read_UINT16(s, blobLen);
+	WLog_Print(rdg->log, WLOG_DEBUG, "EXTAUTH_SC message: error=0x%08" PRIX32 " blob=%" PRIu16,
+	           errorCode, blobLen);
+	if (errorCode != ERROR_SUCCESS)
+	{
+		WLog_Print(rdg->log, WLOG_ERROR, "RD Gateway rejected smart card authentication: %s",
+		           rpc_error_to_string(errorCode));
+		freerdp_set_last_error_log(rdg->context, errorCode);
+		return FALSE;
+	}
+	if (!rdg->sc)
+	{
+		WLog_Print(rdg->log, WLOG_ERROR, "unexpected EXTAUTH_SC message");
+		return FALSE;
+	}
+	if (rdg->scCbSent)
+	{
+		/* gateway acknowledged the channel binding token - authentication finished */
+		WLog_Print(rdg->log, WLOG_INFO, "RD Gateway smart card authentication done");
+		if (Stream_GetRemainingLength(s) >= blobLen)
+			Stream_Seek(s, blobLen);
+		rdg_sc_free(rdg->sc);
+		rdg->sc = nullptr;
+		rdg->scCbSent = FALSE;
+		return rdg_send_tunnel_request(rdg);
+	}
+	if (!Stream_CheckAndLogRequiredLengthWLog(rdg->log, s, blobLen))
+		return FALSE;
+	const BYTE* blob = Stream_Pointer(s);
+	Stream_Seek(s, blobLen);
+	return rdg_sc_continue(rdg, blob, blobLen);
+}
