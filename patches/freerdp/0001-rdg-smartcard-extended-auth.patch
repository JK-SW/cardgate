+/**
+ * FreeRDP: A Remote Desktop Protocol Implementation
+ * RD Gateway smart card extended authentication (HTTP_EXTENDED_AUTH_SC)
+ *
+ * Observed protocol (Windows mstsc <-> RD Gateway, HTTP/websocket transport):
+ *  - HTTP request carries "RDG-Auth-Scheme: SMARTCARD", no HTTP authentication
+ *  - HANDSHAKE_REQUEST with ExtendedAuthentication = HTTP_EXTENDED_AUTH_SC
+ *  - a TLS 1.2 handshake with client certificate is tunnelled in
+ *    PKT_TYPE_EXTENDED_AUTH_MSG blobs, then the normal TUNNEL_CREATE follows.
+ *
+ * Licensed under the Apache License, Version 2.0
+ */
+
+#define OPENSSL_SUPPRESS_DEPRECATED
+
+#include <freerdp/config.h>
+
+#include <string.h>
+#include <stdlib.h>
+#include <dlfcn.h>
+
+#include <openssl/ssl.h>
+#include <openssl/rsa.h>
+#include <openssl/x509.h>
+#include <openssl/err.h>
+#include <openssl/objects.h>
+#include <openssl/evp.h>
+
+#include <winpr/crt.h>
+#include <freerdp/log.h>
+
+#include "rdg_sc.h"
+#include "../../../winpr/libwinpr/ncrypt/pkcs11-headers/pkcs11.h"
+
+#define TAG FREERDP_TAG("core.gateway.rdg_sc")
+
+struct rdg_sc
+{
+	void* lib;
+	CK_FUNCTION_LIST* p11;
+	BOOL weInitialized;
+	CK_SESSION_HANDLE session;
+	BOOL sessionOpen;
+	CK_OBJECT_HANDLE key;
+
+	RSA_METHOD* meth;
+	EVP_PKEY* pkey;
+	X509* cert;
+	SSL_CTX* ctx;
+	SSL* ssl;
+	BIO* rbio;
+	BIO* wbio;
+	unsigned signatures;
+	X509* expectedPeer; /* certificate of the outer TLS connection to the gateway */
+};
+
+/* Set once the card rejected the PIN (or reported it locked). The PIN counter of a smart card is
+ * small, so no further login is attempted by this process, whatever reconnects or fallbacks
+ * FreeRDP would do with the same stored PIN. */
+static BOOL g_pinRejected = FALSE;
+
+BOOL rdg_sc_pin_rejected(void)
+{
+	return g_pinRejected;
+}
+
+static const BYTE di_sha1[] = { 0x30, 0x21, 0x30, 0x09, 0x06, 0x05, 0x2b, 0x0e,
+	                            0x03, 0x02, 0x1a, 0x05, 0x00, 0x04, 0x14 };
+static const BYTE di_sha256[] = { 0x30, 0x31, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01,
+	                              0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20 };
+static const BYTE di_sha384[] = { 0x30, 0x41, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01,
+	                              0x65, 0x03, 0x04, 0x02, 0x02, 0x05, 0x00, 0x04, 0x30 };
+static const BYTE di_sha512[] = { 0x30, 0x51, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01,
+	                              0x65, 0x03, 0x04, 0x02, 0x03, 0x05, 0x00, 0x04, 0x40 };
+
+/* Raw PKCS#1 v1.5 signature over an already encoded DigestInfo, done by the card. */
+static int sc_card_sign(rdgSc* sc, const BYTE* data, size_t dataLen, BYTE* sig, size_t sigMax)
+{
+	CK_MECHANISM mech = { CKM_RSA_PKCS, NULL, 0 };
+	CK_ULONG sigLen = (CK_ULONG)sigMax;
+	CK_RV rv = sc->p11->C_SignInit(sc->session, &mech, sc->key);
+	if (rv != CKR_OK)
+	{
+		WLog_ERR(TAG, "C_SignInit failed 0x%08lx", (unsigned long)rv);
+		return -1;
+	}
+	rv = sc->p11->C_Sign(sc->session, (CK_BYTE_PTR)data, (CK_ULONG)dataLen, sig, &sigLen);
+	if (rv != CKR_OK)
+	{
+		WLog_ERR(TAG, "C_Sign failed 0x%08lx", (unsigned long)rv);
+		return -1;
+	}
+	sc->signatures++;
+	WLog_DBG(TAG, "card signature #%u done (%lu bytes)", sc->signatures, (unsigned long)sigLen);
+	return (int)sigLen;
+}
+
+static rdgSc* sc_from_rsa(const RSA* rsa)
+{
+	return (rdgSc*)RSA_meth_get0_app_data(RSA_get_method(rsa));
+}
+
+static int sc_rsa_sign(int type, const unsigned char* m, unsigned int m_length,
+                       unsigned char* sigret, unsigned int* siglen, const RSA* rsa)
+{
+	rdgSc* sc = sc_from_rsa(rsa);
+	const BYTE* prefix = NULL;
+	size_t prefixLen = 0;
+	BYTE buf[128] = { 0 };
+
+	switch (type)
+	{
+		case NID_sha1:
+			prefix = di_sha1;
+			prefixLen = sizeof(di_sha1);
+			break;
+		case NID_sha256:
+			prefix = di_sha256;
+			prefixLen = sizeof(di_sha256);
+			break;
+		case NID_sha384:
+			prefix = di_sha384;
+			prefixLen = sizeof(di_sha384);
+			break;
+		case NID_sha512:
+			prefix = di_sha512;
+			prefixLen = sizeof(di_sha512);
+			break;
+		default:
+			WLog_ERR(TAG, "unsupported digest nid %d", type);
+			return 0;
+	}
+
+	if (!sc || !prefix || (prefixLen + m_length > sizeof(buf)))
+		return 0;
+
+	memcpy(buf, prefix, prefixLen);
+	memcpy(buf + prefixLen, m, m_length);
+	const int rc = sc_card_sign(sc, buf, prefixLen + m_length, sigret, (size_t)RSA_size(rsa));
+	if (rc <= 0)
+		return 0;
+	*siglen = (unsigned int)rc;
+	return 1;
+}
+
+static int sc_rsa_priv_enc(int flen, const unsigned char* from, unsigned char* to, RSA* rsa,
+                           int padding)
+{
+	rdgSc* sc = sc_from_rsa(rsa);
+	if (!sc || (padding != RSA_PKCS1_PADDING))
+	{
+		WLog_ERR(TAG, "unsupported padding %d", padding);
+		return -1;
+	}
+	return sc_card_sign(sc, from, (size_t)flen, to, (size_t)RSA_size(rsa));
+}
+
+static BOOL hex_to_bin(const char* hex, BYTE** out, size_t* outLen)
+{
+	const size_t len = strlen(hex);
+	if ((len == 0) || (len % 2))
+		return FALSE;
+	BYTE* b = calloc(len / 2, 1);
+	if (!b)
+		return FALSE;
+	for (size_t i = 0; i < len / 2; i++)
+	{
+		unsigned v = 0;
+		if (sscanf(&hex[i * 2], "%2x", &v) != 1)
+		{
+			free(b);
+			return FALSE;
+		}
+		b[i] = (BYTE)v;
+	}
+	*out = b;
+	*outLen = len / 2;
+	return TRUE;
+}
+
+static BOOL sc_pkcs11_open(rdgSc* sc, const char* modulePath, UINT32 slotId, const char* certIdHex,
+                           const char* pin)
+{
+	BYTE* id = NULL;
+	size_t idLen = 0;
+	BOOL ok = FALSE;
+
+	sc->lib = dlopen(modulePath, RTLD_NOW | RTLD_LOCAL);
+	if (!sc->lib)
+	{
+		WLog_ERR(TAG, "cannot load PKCS#11 module %s: %s", modulePath, dlerror());
+		return FALSE;
+	}
+	CK_C_GetFunctionList getList = (CK_C_GetFunctionList)dlsym(sc->lib, "C_GetFunctionList");
+	if (!getList || (getList(&sc->p11) != CKR_OK) || !sc->p11)
+	{
+		WLog_ERR(TAG, "C_GetFunctionList failed");
+		return FALSE;
+	}
+
+	CK_RV rv = sc->p11->C_Initialize(NULL);
+	if (rv == CKR_OK)
+		sc->weInitialized = TRUE;
+	else if (rv != CKR_CRYPTOKI_ALREADY_INITIALIZED)
+	{
+		WLog_ERR(TAG, "C_Initialize failed 0x%08lx", (unsigned long)rv);
+		return FALSE;
+	}
+
+	rv = sc->p11->C_OpenSession((CK_SLOT_ID)slotId, CKF_SERIAL_SESSION, NULL, NULL, &sc->session);
+	if (rv != CKR_OK)
+	{
+		WLog_ERR(TAG, "C_OpenSession(slot %" PRIu32 ") failed 0x%08lx", slotId, (unsigned long)rv);
+		return FALSE;
+	}
+	sc->sessionOpen = TRUE;
+
+	/* Exactly one login attempt - a wrong PIN must not be retried (card PIN counter). */
+	if (g_pinRejected)
+	{
+		WLog_ERR(TAG, "WRONG PIN - the PIN was already rejected, not retrying.");
+		return FALSE;
+	}
+	rv = sc->p11->C_Login(sc->session, CKU_USER, (CK_UTF8CHAR_PTR)pin, (CK_ULONG)strlen(pin));
+	if ((rv == CKR_PIN_INCORRECT) || (rv == CKR_PIN_LEN_RANGE) || (rv == CKR_PIN_INVALID))
+	{
+		g_pinRejected = TRUE;
+		WLog_ERR(TAG, "WRONG PIN - not retrying. Check remaining attempts before trying again!");
+		return FALSE;
+	}
+	if ((rv == CKR_PIN_LOCKED) || (rv == CKR_PIN_EXPIRED))
+	{
+		g_pinRejected = TRUE;
+		WLog_ERR(TAG, "PIN is LOCKED");
+		return FALSE;
+	}
+	if ((rv != CKR_OK) && (rv != CKR_USER_ALREADY_LOGGED_IN))
+	{
+		WLog_ERR(TAG, "C_Login failed 0x%08lx", (unsigned long)rv);
+		return FALSE;
+	}
+
+	if (!hex_to_bin(certIdHex, &id, &idLen))
+	{
+		WLog_ERR(TAG, "invalid certificate id '%s'", certIdHex);
+		return FALSE;
+	}
+
+	CK_OBJECT_CLASS cls = CKO_PRIVATE_KEY;
+	CK_ATTRIBUTE tmpl[] = { { CKA_CLASS, &cls, sizeof(cls) }, { CKA_ID, id, (CK_ULONG)idLen } };
+	CK_ULONG found = 0;
+	rv = sc->p11->C_FindObjectsInit(sc->session, tmpl, 2);
+	if (rv == CKR_OK)
+	{
+		rv = sc->p11->C_FindObjects(sc->session, &sc->key, 1, &found);
+		sc->p11->C_FindObjectsFinal(sc->session);
+	}
+	if ((rv != CKR_OK) || (found != 1))
+		WLog_ERR(TAG, "private key with id %s not found (rv 0x%08lx)", certIdHex,
+		         (unsigned long)rv);
+	else
+		ok = TRUE;
+
+	free(id);
+	return ok;
+}
+
+/* The inner TLS server must present the certificate of the gateway that the outer, verified TLS
+ * connection ends at. It is checked before the client certificate is sent and signed. */
+static int sc_verify_peer(int preverify_ok, X509_STORE_CTX* store)
+{
+	WINPR_UNUSED(preverify_ok);
+	if (X509_STORE_CTX_get_error_depth(store) != 0)
+		return 1;
+	SSL* ssl = X509_STORE_CTX_get_ex_data(store, SSL_get_ex_data_X509_STORE_CTX_idx());
+	rdgSc* sc = ssl ? (rdgSc*)SSL_get_app_data(ssl) : NULL;
+	if (!sc || !sc->expectedPeer)
+		return 1;
+	X509* peer = X509_STORE_CTX_get_current_cert(store);
+	if (peer && (X509_cmp(peer, sc->expectedPeer) == 0))
+		return 1;
+	WLog_ERR(TAG, "inner TLS certificate differs from the RD Gateway certificate, aborting");
+	return 0;
+}
+
+static BOOL sc_openssl_setup(rdgSc* sc, const BYTE* certDer, size_t certLen, const char* sni)
+{
+	const BYTE* p = certDer;
+	sc->cert = d2i_X509(NULL, &p, (long)certLen);
+	if (!sc->cert)
+		return FALSE;
+
+	const EVP_PKEY* pub = X509_get0_pubkey(sc->cert);
+	const RSA* pubRsa = pub ? EVP_PKEY_get0_RSA(pub) : NULL;
+	if (!pubRsa)
+	{
+		WLog_ERR(TAG, "client certificate has no RSA key");
+		return FALSE;
+	}
+
+	sc->meth = RSA_meth_dup(RSA_PKCS1_OpenSSL());
+	if (!sc->meth)
+		return FALSE;
+	RSA_meth_set1_name(sc->meth, "freerdp-rdg-smartcard");
+	RSA_meth_set0_app_data(sc->meth, sc);
+	RSA_meth_set_sign(sc->meth, sc_rsa_sign);
+	RSA_meth_set_priv_enc(sc->meth, sc_rsa_priv_enc);
+
+	RSA* rsa = RSA_new();
+	if (!rsa)
+		return FALSE;
+	BIGNUM* n = BN_dup(RSA_get0_n(pubRsa));
+	BIGNUM* e = BN_dup(RSA_get0_e(pubRsa));
+	if (!n || !e || !RSA_set0_key(rsa, n, e, NULL))
+	{
+		BN_free(n);
+		BN_free(e);
+		RSA_free(rsa);
+		return FALSE;
+	}
+	RSA_set_method(rsa, sc->meth);
+	sc->pkey = EVP_PKEY_new();
+	if (!sc->pkey || !EVP_PKEY_assign_RSA(sc->pkey, rsa))
+	{
+		RSA_free(rsa);
+		return FALSE;
+	}
+
+	sc->ctx = SSL_CTX_new(TLS_client_method());
+	if (!sc->ctx)
+		return FALSE;
+	/* The gateway speaks TLS 1.2 and offers only PKCS#1 v1.5 signature algorithms. */
+	SSL_CTX_set_min_proto_version(sc->ctx, TLS1_2_VERSION);
+	SSL_CTX_set_max_proto_version(sc->ctx, TLS1_2_VERSION);
+	SSL_CTX_set1_sigalgs_list(sc->ctx, "RSA+SHA256:RSA+SHA384:RSA+SHA512:RSA+SHA1");
+	/* The outer TLS connection verified the gateway; the inner one must use the same certificate
+	 * (sc_verify_peer), the CA chain is not checked again. */
+	SSL_CTX_set_verify(sc->ctx, SSL_VERIFY_PEER, sc_verify_peer);
+	if (!SSL_CTX_use_certificate(sc->ctx, sc->cert) || !SSL_CTX_use_PrivateKey(sc->ctx, sc->pkey))
+	{
+		WLog_ERR(TAG, "cannot attach smart card certificate/key to TLS context");
+		return FALSE;
+	}
+
+	sc->ssl = SSL_new(sc->ctx);
+	sc->rbio = BIO_new(BIO_s_mem());
+	sc->wbio = BIO_new(BIO_s_mem());
+	if (!sc->ssl || !sc->rbio || !sc->wbio)
+		return FALSE;
+	SSL_set_bio(sc->ssl, sc->rbio, sc->wbio); /* ssl owns the bios now */
+	SSL_set_app_data(sc->ssl, sc);
+	if (sni)
+		SSL_set_tlsext_host_name(sc->ssl, sni);
+	SSL_set_connect_state(sc->ssl);
+	return TRUE;
+}
+
+rdgSc* rdg_sc_new(const char* modulePath, UINT32 slotId, const char* certIdHex,
+                  const BYTE* certDer, size_t certLen, const char* pin, const char* sni)
+{
+	if (!modulePath || !certIdHex || !certDer || !pin)
+	{
+		WLog_ERR(TAG, "missing PKCS#11 module, certificate id, certificate or PIN");
+		return NULL;
+	}
+	rdgSc* sc = calloc(1, sizeof(rdgSc));
+	if (!sc)
+		return NULL;
+	if (!sc_openssl_setup(sc, certDer, certLen, sni) ||
+	    !sc_pkcs11_open(sc, modulePath, slotId, certIdHex, pin))
+	{
+		rdg_sc_free(sc);
+		return NULL;
+	}
+	WLog_INFO(TAG, "smart card ready for RD Gateway authentication (module %s, slot %" PRIu32 ")",
+	          modulePath, slotId);
+	return sc;
+}
+
+void rdg_sc_free(rdgSc* sc)
+{
+	if (!sc)
+		return;
+	SSL_free(sc->ssl);
+	SSL_CTX_free(sc->ctx);
+	EVP_PKEY_free(sc->pkey);
+	X509_free(sc->cert);
+	X509_free(sc->expectedPeer);
+	RSA_meth_free(sc->meth);
+	if (sc->p11)
+	{
+		if (sc->sessionOpen)
+		{
+			sc->p11->C_Logout(sc->session);
+			sc->p11->C_CloseSession(sc->session);
+		}
+		if (sc->weInitialized)
+			sc->p11->C_Finalize(NULL);
+	}
+	if (sc->lib)
+		dlclose(sc->lib);
+	free(sc);
+}
+
+BOOL rdg_sc_step(rdgSc* sc, const BYTE* in, size_t inLen, BYTE** out, size_t* outLen, BOOL* done)
+{
+	*out = NULL;
+	*outLen = 0;
+	*done = FALSE;
+
+	if (in && inLen)
+	{
+		if (BIO_write(sc->rbio, in, (int)inLen) != (int)inLen)
+			return FALSE;
+	}
+
+	const int rc = SSL_do_handshake(sc->ssl);
+	if (rc == 1)
+	{
+		*done = TRUE;
+		WLog_INFO(TAG, "inner TLS handshake with RD Gateway completed (%s, %s)",
+		          SSL_get_version(sc->ssl), SSL_get_cipher_name(sc->ssl));
+	}
+	else
+	{
+		const int err = SSL_get_error(sc->ssl, rc);
+		if (err != SSL_ERROR_WANT_READ)
+		{
+			char buf[256] = { 0 };
+			ERR_error_string_n(ERR_get_error(), buf, sizeof(buf));
+			WLog_ERR(TAG, "inner TLS handshake failed: ssl error %d (%s)", err, buf);
+			return FALSE;
+		}
+	}
+
+	return rdg_sc_drain(sc, out, outLen);
+}
+
+char* rdg_sc_user_id_from_sha1(const BYTE sha1[20])
+{
+	static const char alpha[] =
+	    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789#-";
+	char marshaled[64] = { '@', '@', 'B' };
+	size_t n = 3;
+	UINT32 bits = 0;
+	int nb = 0;
+	for (size_t i = 0; i < 20; i++)
+	{
+		bits |= ((UINT32)sha1[i]) << nb;
+		nb += 8;
+		while (nb >= 6)
+		{
+			marshaled[n++] = alpha[bits & 0x3f];
+			bits >>= 6;
+			nb -= 6;
+		}
+	}
+	if (nb > 0)
+		marshaled[n++] = alpha[bits & 0x3f];
+
+	BYTE wide[128] = { 0 };
+	for (size_t i = 0; i < n; i++)
+		wide[2 * i] = (BYTE)marshaled[i];
+
+	char* b64 = calloc(1, 4 * ((2 * n + 2) / 3) + 1);
+	if (!b64)
+		return NULL;
+	EVP_EncodeBlock((unsigned char*)b64, wide, (int)(2 * n));
+	return b64;
+}
+
+BOOL rdg_sc_set_expected_peer(rdgSc* sc, struct x509_st* certificate)
+{
+	if (!sc || !certificate)
+		return FALSE;
+	if (!X509_up_ref(certificate))
+		return FALSE;
+	X509_free(sc->expectedPeer);
+	sc->expectedPeer = certificate;
+	return TRUE;
+}
+
+struct ssl_st* rdg_sc_ssl(rdgSc* sc)
+{
+	return sc ? sc->ssl : NULL;
+}
+
+BOOL rdg_sc_drain(rdgSc* sc, BYTE** out, size_t* outLen)
+{
+	*out = NULL;
+	*outLen = 0;
+	const size_t pending = BIO_ctrl_pending(sc->wbio);
+	if (pending > 0)
+	{
+		*out = malloc(pending);
+		if (!*out)
+			return FALSE;
+		if (BIO_read(sc->wbio, *out, (int)pending) != (int)pending)
+		{
+			free(*out);
+			*out = NULL;
+			return FALSE;
+		}
+		*outLen = pending;
+	}
+	return TRUE;
+}
