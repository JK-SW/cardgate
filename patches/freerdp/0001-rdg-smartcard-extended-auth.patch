+static BOOL rdg_send_extauth_blob(rdpRdg* rdg, const BYTE* blob, size_t blobLen)
+{
+	WINPR_ASSERT(rdg);
+	if (blobLen > UINT16_MAX)
+		return FALSE;
+	const UINT32 packetSize = (UINT32)(8 + 4 + 2 + blobLen);
+	wStream* s = Stream_New(nullptr, packetSize);
+	if (!s)
+		return FALSE;
+	Stream_Write_UINT16(s, PKT_TYPE_EXTENDED_AUTH_MSG); /* Type (2 bytes) */
+	Stream_Write_UINT16(s, 0);                          /* Reserved (2 bytes) */
+	Stream_Write_UINT32(s, packetSize);                 /* PacketLength (4 bytes) */
+	Stream_Write_UINT32(s, ERROR_SUCCESS);              /* Error code */
+	Stream_Write_UINT16(s, (UINT16)blobLen);
+	Stream_Write(s, blob, blobLen);
+	Stream_SealLength(s);
+	const BOOL status = rdg_write_packet(rdg, s);
+	Stream_Free(s, TRUE);
+	return status;
+}
