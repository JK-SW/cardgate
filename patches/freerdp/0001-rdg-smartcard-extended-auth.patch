+/* HTTP_EXTENDED_AUTH_SC: pick the card certificate, ask for the PIN once, open the card. */
+WINPR_ATTR_NODISCARD
+static BOOL rdg_sc_init(rdpRdg* rdg)
+{
+	rdpContext* context = rdg->context;
+	rdpSettings* settings = context->settings;
+
+	if (rdg_sc_pin_rejected())
+	{
+		/* Never offer a rejected PIN to the card again (reconnect, protocol fallback, ...). */
+		WLog_Print(rdg->log, WLOG_ERROR, "WRONG PIN - the PIN was already rejected, not retrying.");
+		if (!freerdp_settings_set_string(settings, FreeRDP_GatewayPassword, nullptr))
+			WLog_Print(rdg->log, WLOG_WARN, "cannot clear the rejected PIN");
+		return FALSE;
+	}
+
+	if (!rdg->smartcard && !smartcard_getCert(context, &rdg->smartcard, TRUE))
+		return FALSE;
+
+	if (!rdg_get_gateway_credentials(context, AUTH_SMARTCARD_PIN))
+		return FALSE;
+
+	const char* pin = freerdp_settings_get_string(settings, FreeRDP_GatewayPassword);
+	const char* module = freerdp_settings_get_string(settings, FreeRDP_Pkcs11Module);
+	const char* args = rdg->smartcard->pkinitArgs;
+	const char* idp = args ? strstr(args, "certid=") : nullptr;
+	if (!pin || !*pin || !module || !idp)
+	{
+		WLog_Print(rdg->log, WLOG_ERROR,
+		           "smart card gateway auth needs PIN, /kerberos:pkcs11-module and a card "
+		           "certificate id (pin=%s module=%s args=%s)",
+		           (pin && *pin) ? "set" : "missing", module ? module : "missing",
+		           args ? args : "missing");
+		return FALSE;
+	}
+	char certId[256] = WINPR_C_ARRAY_INIT;
+	(void)sscanf(idp + 7, "%255[0-9a-fA-F]", certId);
+
+	size_t derLen = 0;
+	BYTE* der = freerdp_certificate_get_der(rdg->smartcard->certificate, &derLen);
+	if (!der)
+		return FALSE;
+
+	rdg->sc = rdg_sc_new(module, rdg->smartcard->slotId, certId, der, derLen, pin,
+	                     settings->GatewayHostname);
+	free(der);
+	if (rdg->sc && rdg->tlsOut && rdg->tlsOut->ssl)
+	{
+		X509* gateway = SSL_get1_peer_certificate(rdg->tlsOut->ssl);
+		const BOOL pinned = gateway && rdg_sc_set_expected_peer(rdg->sc, gateway);
+		X509_free(gateway);
+		if (!pinned)
+		{
+			WLog_Print(rdg->log, WLOG_ERROR, "cannot get the RD Gateway certificate");
+			rdg_sc_free(rdg->sc);
+			rdg->sc = nullptr;
+			return FALSE;
+		}
+	}
+	if (!rdg->sc && rdg_sc_pin_rejected())
+	{
+		/* Forget the rejected PIN so nothing can pass it on (e.g. as the logon password). */
+		if (!freerdp_settings_set_string(settings, FreeRDP_GatewayPassword, nullptr) ||
+		    !freerdp_settings_set_string(settings, FreeRDP_Password, nullptr))
+			return FALSE;
+	}
+	return rdg->sc != nullptr;
+}
