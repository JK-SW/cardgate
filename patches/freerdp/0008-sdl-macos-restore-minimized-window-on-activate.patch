+void SdlContext::restoreMinimizedWindows()
+{
+	for (auto& w : _windows)
+	{
+		auto window = w.second.window();
+		if (!window || ((SDL_GetWindowFlags(window) & SDL_WINDOW_MINIMIZED) == 0))
+			continue;
+		std::ignore = SDL_RestoreWindow(window);
+	}
+}
+
 int SdlContext::exitCode() const
 {
 	return _exitCode;
