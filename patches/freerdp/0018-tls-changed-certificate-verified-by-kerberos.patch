+BOOL freerdp_tls_has_pending_certificate(const rdpTls* tls)
+{
+	return tls && tls->pendingCertificate;
+}
+
+void freerdp_tls_save_pending_certificate(rdpTls* tls)
+{
+	WINPR_ASSERT(tls);
+	if (!tls->pendingCertificate)
+		return;
+
+	/* The computer is verified either way: when the store fails, the next connection verifies
+	 * the certificate again. */
+	if (freerdp_certificate_store_save_data(tls->certificate_store, tls->pendingCertificate))
+		WLog_INFO(TAG,
+		          "changed certificate of %s:%" PRIu16
+		          " verified by Kerberos, replacing the stored one.",
+		          freerdp_certificate_data_get_host(tls->pendingCertificate),
+		          freerdp_certificate_data_get_port(tls->pendingCertificate));
+	else
+		WLog_WARN(TAG, "changed certificate of %s:%" PRIu16
+		               " verified by Kerberos, unable to store it.",
+		          freerdp_certificate_data_get_host(tls->pendingCertificate),
+		          freerdp_certificate_data_get_port(tls->pendingCertificate));
+	freerdp_certificate_data_free(tls->pendingCertificate);
+	tls->pendingCertificate = nullptr;
+}
