+/* The security package that authenticated the connection is Kerberos (in Negotiate). */
+WINPR_ATTR_NODISCARD
+static BOOL nla_authenticated_by_kerberos(rdpNla* nla)
+{
+	SecurityFunctionTable* table = nullptr;
+	CtxtHandle context = WINPR_C_ARRAY_INIT;
+	SecPkgContext_PackageInfo info = WINPR_C_ARRAY_INIT;
+
+	credssp_auth_tableAndContext(nla->auth, &table, &context);
+	if (!table || !table->QueryContextAttributes || !table->FreeContextBuffer)
+		return FALSE;
+	if (table->QueryContextAttributes(&context, SECPKG_ATTR_PACKAGE_INFO, &info) != SEC_E_OK ||
+	    !info.PackageInfo)
+		return FALSE;
+
+	const BOOL kerberos =
+	    info.PackageInfo->Name && (_tcscmp(info.PackageInfo->Name, KERBEROS_SSP_NAME) == 0);
+	table->FreeContextBuffer(info.PackageInfo);
+	return kerberos;
+}
