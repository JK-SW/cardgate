+#if defined(__APPLE__) && defined(__aarch64__)
+/* The Objective-C runtime, declared here: its headers define BOOL differently from WinPR. */
+extern "C"
+{
+	void* objc_getClass(const char* name);
+	void* sel_registerName(const char* name);
+	void objc_msgSend(void);
+	void* objc_autoreleasePoolPush(void);
+	void objc_autoreleasePoolPop(void* pool);
+}
+
+namespace
+{
+	struct MacEdgeInsets
+	{
+		double top;
+		double left;
+		double bottom;
+		double right;
+	};
+} // namespace
+#endif
+
+/* A fullscreen window (in its own Space, as SDL makes it by default) starts below the camera
+ * housing (notch) of a built-in display. The display is found as SDL finds its bounds: by the
+ * CoreGraphics display of the screen (NSScreenNumber). arm64 only: there objc_msgSend also
+ * returns structures. */
+double SdlWindow::notchHeight(SDL_DisplayID id)
+{
+#if defined(__APPLE__) && defined(__aarch64__)
+	/* AppKit only on the main thread (all callers are there now). */
+	SDL_Rect bounds = {};
+	if (!SDL_IsMainThread() || !SDL_GetDisplayBounds(id, &bounds))
+		return 0.0;
+
+	using SendObject = void* (*)(void*, void*);
+	using SendObjectArg = void* (*)(void*, void*, const void*);
+	using SendIndex = void* (*)(void*, void*, unsigned long);
+	using SendCount = unsigned long (*)(void*, void*);
+	using SendNumber = unsigned int (*)(void*, void*);
+	using SendInsets = MacEdgeInsets (*)(void*, void*);
+	const auto send = reinterpret_cast<SendObject>(objc_msgSend);
+
+	double notch = 0.0;
+	void* pool = objc_autoreleasePoolPush();
+	void* screens = send(objc_getClass("NSScreen"), sel_registerName("screens"));
+	const auto count =
+	    screens ? reinterpret_cast<SendCount>(objc_msgSend)(screens, sel_registerName("count")) : 0;
+	for (unsigned long x = 0; x < count; x++)
+	{
+		void* screen = reinterpret_cast<SendIndex>(objc_msgSend)(
+		    screens, sel_registerName("objectAtIndex:"), x);
+		void* description = screen ? send(screen, sel_registerName("deviceDescription")) : nullptr;
+		void* number = description ? reinterpret_cast<SendObjectArg>(objc_msgSend)(
+		                                 description, sel_registerName("objectForKey:"),
+		                                 CFSTR("NSScreenNumber"))
+		                           : nullptr;
+		if (!number)
+			continue;
+		const CGDirectDisplayID display = reinterpret_cast<SendNumber>(objc_msgSend)(
+		    number, sel_registerName("unsignedIntValue"));
+		const CGRect r = CGDisplayBounds(display);
+		if ((static_cast<int>(r.origin.x) != bounds.x) ||
+		    (static_cast<int>(r.origin.y) != bounds.y) ||
+		    (static_cast<int>(r.size.width) != bounds.w) ||
+		    (static_cast<int>(r.size.height) != bounds.h))
+			continue;
+		const auto insets =
+		    reinterpret_cast<SendInsets>(objc_msgSend)(screen, sel_registerName("safeAreaInsets"));
+		if ((insets.top > 0.0) && (insets.top < r.size.height / 2.0))
+			notch = insets.top;
+		break;
+	}
+	objc_autoreleasePoolPop(pool);
+	return notch;
+#else
+	WINPR_UNUSED(id);
+	return 0.0;
+#endif
+}
