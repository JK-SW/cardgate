+#ifndef _WIN32
+/* The certificates read from the card for the RD Gateway serve the network level authentication
+ * that follows in the same connection attempt: a slow PKCS#11 module took seconds to list them
+ * again. Kept only for that one use, for the same module and reader and for at most
+ * CARD_CACHE_LIFETIME_MS; a later gateway authentication (another attempt, a reconnect) reads the
+ * card again. */
+#define CARD_CACHE_LIFETIME_MS (5ULL * 60ULL * 1000ULL)
+
+typedef struct
+{
+	SmartcardCertInfo* key; /* what was read about the key, not the parsed certificate */
+	BYTE* der;
+	DWORD derLength;
+} CachedCardKey;
+
+static pthread_mutex_t card_cache_lock = PTHREAD_MUTEX_INITIALIZER;
+static CachedCardKey* card_cache_keys = nullptr;
+static size_t card_cache_count = 0;
+static char* card_cache_module = nullptr;
+static char* card_cache_reader = nullptr;
+static UINT64 card_cache_time = 0;
+
+/* Copies what list_provider_keys reads about a key from the card (both ways: into the cache and
+ * back for the network level authentication). */
+WINPR_ATTR_NODISCARD
+static SmartcardCertInfo* card_key_copy(const SmartcardCertInfo* src)
+{
+	SmartcardCertInfo* dst = calloc(1, sizeof(SmartcardCertInfo));
+	if (!dst)
+		return nullptr;
+
+	dst->slotId = src->slotId;
+	dst->keyName = src->keyName ? _strdup(src->keyName) : nullptr;
+	dst->csp = src->csp ? _wcsdup(src->csp) : nullptr;
+	dst->reader = src->reader ? _wcsdup(src->reader) : nullptr;
+	dst->containerName = src->containerName ? _wcsdup(src->containerName) : nullptr;
+	dst->pkinitArgs = src->pkinitArgs ? _strdup(src->pkinitArgs) : nullptr;
+	if ((src->keyName && !dst->keyName) || (src->csp && !dst->csp) ||
+	    (src->reader && !dst->reader) || (src->containerName && !dst->containerName) ||
+	    (src->pkinitArgs && !dst->pkinitArgs))
+	{
+		smartcardCertInfo_Free(dst);
+		return nullptr;
+	}
+	return dst;
+}
+
+static void card_cache_clear(void)
+{
+	for (size_t i = 0; card_cache_keys && (i < card_cache_count); i++)
+	{
+		smartcardCertInfo_Free(card_cache_keys[i].key);
+		free(card_cache_keys[i].der);
+	}
+	free(card_cache_keys);
+	card_cache_keys = nullptr;
+	card_cache_count = 0;
+	free(card_cache_module);
+	card_cache_module = nullptr;
+	free(card_cache_reader);
+	card_cache_reader = nullptr;
+}
+
+static BOOL card_cache_same(const char* a, const char* b)
+{
+	if (!a || !b)
+		return a == b;
+	return strcmp(a, b) == 0;
+}
+
+/* Records a key with its certificate as read from the card (before any filter). */
+WINPR_ATTR_NODISCARD
+static BOOL card_cache_add(const SmartcardCertInfo* cert, const BYTE* der, DWORD derLength)
+{
+	CachedCardKey entry = { card_key_copy(cert), malloc(derLength), derLength };
+	CachedCardKey* keys = nullptr;
+	if (entry.key && entry.der)
+		keys = realloc(card_cache_keys, sizeof(CachedCardKey) * (card_cache_count + 1));
+	if (!keys)
+	{
+		smartcardCertInfo_Free(entry.key);
+		free(entry.der);
+		return FALSE;
+	}
+
+	memcpy(entry.der, der, derLength);
+	card_cache_keys = keys;
+	card_cache_keys[card_cache_count++] = entry;
+	return TRUE;
+}
+#endif /* _WIN32 */
