+#ifndef _WIN32
+/* The certificates kept for the network level authentication after the gateway, filtered as if
+ * read from the card again; the cache is used once. Caller holds card_cache_lock. */
+WINPR_ATTR_NODISCARD
+static BOOL card_cache_take(const char* userFilter, const char* domainFilter,
+                            SmartcardCertInfo*** pcerts, size_t* pcount)
+{
+	BOOL ret = FALSE;
+	SmartcardCertInfo** cert_list = nullptr;
+	size_t count = 0;
+
+	for (size_t i = 0; card_cache_keys && (i < card_cache_count); i++)
+	{
+		const CachedCardKey* key = &card_cache_keys[i];
+		SmartcardCertInfo* cert = card_key_copy(key->key);
+		if (!cert)
+			goto out;
+
+		if (!set_info_certificate(cert, key->der, key->derLength, userFilter, domainFilter))
+		{
+			smartcardCertInfo_Free(cert);
+			continue;
+		}
+
+		if (!add_cert_to_list(&cert_list, &count, cert))
+		{
+			smartcardCertInfo_Free(cert);
+			goto out;
+		}
+	}
+
+	WLog_INFO(TAG,
+	          "smart card certificates read for the gateway reused, not read again (%" PRIuz
+	          " of %" PRIuz " usable)",
+	          count, card_cache_count);
+	*pcerts = cert_list;
+	*pcount = count;
+	ret = TRUE;
+out:
+	if (!ret)
+		smartcardCertList_Free(cert_list, count);
+	card_cache_clear();
+	return ret;
+}
+#endif /* _WIN32 */
