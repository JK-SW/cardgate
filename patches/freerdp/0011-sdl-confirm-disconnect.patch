+#if defined(__APPLE__)
+void sdl_macos_remove_quit_shortcut()
+{
+	using SendObject = void* (*)(void*, void*);
+	using SendIndex = void* (*)(void*, void*, long);
+	using SendCount = long (*)(void*, void*);
+	using SendFind = long (*)(void*, void*, void*, void*);
+	using SendSet = void (*)(void*, void*, const void*);
+	const auto send = reinterpret_cast<SendObject>(objc_msgSend);
+	const auto count = reinterpret_cast<SendCount>(objc_msgSend);
+	const auto item = reinterpret_cast<SendIndex>(objc_msgSend);
+
+	void* app = send(objc_getClass("NSApplication"), sel_registerName("sharedApplication"));
+	void* menu = app ? send(app, sel_registerName("mainMenu")) : nullptr;
+	if (!menu || (count(menu, sel_registerName("numberOfItems")) < 1))
+		return;
+	void* appItem = item(menu, sel_registerName("itemAtIndex:"), 0);
+	void* appMenu = appItem ? send(appItem, sel_registerName("submenu")) : nullptr;
+	if (!appMenu)
+		return;
+	const long index = reinterpret_cast<SendFind>(objc_msgSend)(
+	    appMenu, sel_registerName("indexOfItemWithTarget:andAction:"), nullptr,
+	    sel_registerName("terminate:"));
+	if (index < 0)
+		return;
+	void* quit = item(appMenu, sel_registerName("itemAtIndex:"), index);
+	if (quit)
+		reinterpret_cast<SendSet>(objc_msgSend)(quit, sel_registerName("setKeyEquivalent:"),
+		                                        CFSTR(""));
+}
+
+/* Closes the open question once the process is told to end (info: the flag set by the signal
+ * handler, which cannot do this itself). Runs on the main run loop, also while the question is
+ * shown. */
+static void close_question_on_signal(CFRunLoopTimerRef timer, void* info)
+{
+	WINPR_UNUSED(timer);
+	/* Also a quit request of the system (logout, restart) that came meanwhile. */
+	if (!static_cast<std::atomic<bool>*>(info)->load() && !SDL_HasEvent(SDL_EVENT_QUIT))
+		return;
+	using SendObject = void* (*)(void*, void*);
+	using Send = void (*)(void*, void*);
+	void* app = reinterpret_cast<SendObject>(objc_msgSend)(objc_getClass("NSApplication"),
+	                                                       sel_registerName("sharedApplication"));
+	if (app)
+		reinterpret_cast<Send>(objc_msgSend)(app, sel_registerName("abortModal"));
+}
+#endif
+
+static const char* env_or(const char* name, const char* fallback)
+{
+	const char* value = getenv(name);
+	return (value && *value) ? value : fallback;
+}
+
+/* Whether the user really wants to end the session they closed (window closed, Cmd+Q). Asked
+ * only while connected and when the environment variable FREERDP_CONFIRM_DISCONNECT holds the
+ * question (the launching application passes the texts in the user's language:
+ * FREERDP_CONFIRM_DISCONNECT_DETAIL, _BUTTON and _CANCEL). Never asked when the process is told to
+ * end by a signal; a quit request of the system (logout, restart) does not ask either. */
+bool SdlContext::confirmDisconnect(SDL_WindowID windowID)
+{
+	const char* question = getenv("FREERDP_CONFIRM_DISCONNECT");
+	if (!question || !*question || !isConnected() || _quitBySignal)
+		return true;
+	if (_confirmingDisconnect)
+		return false; /* closed again while the question is shown */
+
+	_confirmingDisconnect = true;
+	const SDL_MessageBoxButtonData buttons[] = {
+		{ SDL_MESSAGEBOX_BUTTON_ESCAPEKEY_DEFAULT, 0,
+		  env_or("FREERDP_CONFIRM_DISCONNECT_CANCEL", "Cancel") },
+		{ SDL_MESSAGEBOX_BUTTON_RETURNKEY_DEFAULT, 1,
+		  env_or("FREERDP_CONFIRM_DISCONNECT_BUTTON", "Disconnect") },
+	};
+	/* On the window that was closed, so the question is where the user looks. */
+	SDL_Window* parent = nullptr;
+	if (auto window = getWindowForId(windowID))
+		parent = window->window();
+	else if (!_windows.empty())
+		parent = _windows.begin()->second.window();
+	const SDL_MessageBoxData data = { SDL_MESSAGEBOX_WARNING,
+	                                  parent,
+	                                  question,
+	                                  env_or("FREERDP_CONFIRM_DISCONNECT_DETAIL", ""),
+	                                  static_cast<int>(ARRAYSIZE(buttons)),
+	                                  buttons,
+	                                  nullptr };
+	int button = 0;
+#if defined(__APPLE__)
+	CFRunLoopTimerContext timerContext = { 0, &_quitBySignal, nullptr, nullptr, nullptr };
+	CFRunLoopTimerRef watch = CFRunLoopTimerCreate(nullptr, CFAbsoluteTimeGetCurrent() + 0.2, 0.2,
+	                                               0, 0, close_question_on_signal, &timerContext);
+	if (watch)
+		CFRunLoopAddTimer(CFRunLoopGetMain(), watch, kCFRunLoopCommonModes);
+#endif
+	const bool shown = SDL_ShowMessageBox(&data, &button);
+#if defined(__APPLE__)
+	if (watch)
+	{
+		CFRunLoopTimerInvalidate(watch);
+		CFRelease(watch);
+	}
+#endif
+	_confirmingDisconnect = false;
+
+	/* Closing again while asked is part of the same request. */
+	SDL_FlushEvent(SDL_EVENT_WINDOW_CLOSE_REQUESTED);
+	if (_quitBySignal || SDL_HasEvent(SDL_EVENT_QUIT))
+		return true;
+	if (!shown)
+	{
+		WLog_Print(_log, WLOG_WARN, "cannot ask before disconnecting: %s", SDL_GetError());
+		return true;
+	}
+	const bool disconnect = (button == 1);
+	WLog_Print(_log, WLOG_INFO, "disconnect %s by the user",
+	           disconnect ? "confirmed" : "cancelled");
+	return disconnect;
+}
+
+/* While reconnecting another error may already be set and freerdp_abort_connect_context keeps it;
+ * the cancel replaces it, so the reconnection loop stops (client_auto_reconnect_do). */
+void SdlContext::disconnectRequested()
+{
+	/* A reconnection attempt may reset the last error (rdg_connect): this flag stays. */
+	_disconnectRequested = true;
+	freerdp_set_last_error_log(context(), FREERDP_ERROR_CONNECT_CANCELLED);
+	std::ignore = freerdp_abort_connect_context(context());
+}
+
+bool SdlContext::isDisconnectRequested() const
+{
+	return _disconnectRequested;
+}
+
+void SdlContext::quitBySignal()
+{
+	_quitBySignal = true;
+}
+
 rdpContext* SdlContext::context() const
 {
 	WINPR_ASSERT(_context);
