+	/* Values given on the command line apply to every monitor, as in the display channel. */
+	const auto mask = freerdp_settings_get_uint64(settings, FreeRDP_MonitorOverrideFlags);
+	for (auto& monitor : monitors)
+	{
+		if ((mask & FREERDP_MONITOR_OVERRIDE_ORIENTATION) != 0)
+			monitor.attributes.orientation =
