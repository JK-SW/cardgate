+/* The scale sent when connecting (TS_UD_CS_CORE): the one of the display the session opens on
+ * (the primary of the monitors sent, see sdl_apply_display_properties), so even the sign-in
+ * screen has it. It is left at the default for a
+ * scale given on the command line, which sets it, and the display channel takes over once
+ * connected (the override flag is not set, so a window moved to another display follows it). */
+[[nodiscard]] static BOOL sdl_apply_connect_scale(SdlContext* sdl)
+{
+	rdpSettings* settings = sdl->context()->settings;
+	WINPR_ASSERT(settings);
+
+	const auto mask = freerdp_settings_get_uint64(settings, FreeRDP_MonitorOverrideFlags);
+	if ((mask & FREERDP_MONITOR_OVERRIDE_DESKTOP_SCALE) != 0)
+		return TRUE;
+	UINT32 scale = 0;
+	const auto count = freerdp_settings_get_uint32(settings, FreeRDP_MonitorCount);
+	for (UINT32 x = 0; x < count; x++)
+	{
+		auto monitor = static_cast<const rdpMonitor*>(
+		    freerdp_settings_get_pointer_array(settings, FreeRDP_MonitorDefArray, x));
+		if (monitor && monitor->is_primary)
+			scale = monitor->attributes.desktopScaleFactor;
+	}
+	/* A window: no monitors are sent, use the display it opens on. */
+	if ((count == 0) && !sdl->monitorIds().empty())
+		scale = sdl->getDisplay(sdl->monitorIds().front()).attributes.desktopScaleFactor;
+	if ((scale < 100) || (scale > 500))
+		return TRUE;
+	WLog_INFO(TAG, "desktop scale when connecting: %" PRIu32, scale);
+	return freerdp_settings_set_uint32(settings, FreeRDP_DesktopScaleFactor, scale);
+}
+
 BOOL sdl_detect_monitors(SdlContext* sdl, UINT32* pMaxWidth, UINT32* pMaxHeight)
 {
 	WINPR_ASSERT(sdl);
