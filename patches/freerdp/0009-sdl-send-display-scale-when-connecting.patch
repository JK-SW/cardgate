+		if ((mask & FREERDP_MONITOR_OVERRIDE_DESKTOP_SCALE) != 0)
+			monitor.attributes.desktopScaleFactor =
+			    freerdp_settings_get_uint32(settings, FreeRDP_DesktopScaleFactor);
+		if ((mask & FREERDP_MONITOR_OVERRIDE_DEVICE_SCALE) != 0)
+			monitor.attributes.deviceScaleFactor =
+			    freerdp_settings_get_uint32(settings, FreeRDP_DeviceScaleFactor);
+	}
+	if (!freerdp_settings_set_monitor_def_array_sorted(settings, monitors.data(), monitors.size()))
+		return FALSE;
+	/* Send the monitor attributes (scale, orientation) when connecting (TS_UD_CS_MONITOR_EX);
+	 * without them the server starts every monitor at 100 %. They only go along with the monitor
+	 * list (TS_UD_CS_MONITOR), which is sent for more than one monitor; a single one gets its
